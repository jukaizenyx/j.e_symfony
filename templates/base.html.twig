<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#f7f5f0">
        <title>{% block title %}J.E Eullaran Essentials{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/je_logo.svg') }}" type="image/svg+xml">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <script src="{{ asset('javascript.js') }}" defer></script>
    </head>
    <body
        data-cart-action-url="{{ path('app_cart_action', { action: 'add' })|replace({'/add': ''}) }}"
        data-cart-token="{{ csrf_token('cart_action') }}"
        data-checkout-url="{{ path('app_checkout') }}"
        data-logged-in="{{ app.user ? 'true' : 'false' }}"
    >
        {% block body %}{% endblock %}
    </body>
</html>
