{% extends 'base.html.twig' %}

{% block title %}Manage Orders — J.E Essentials{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('shop_css/shop.css') }}"><link rel="stylesheet" href="{{ asset('admin_css/admin.css') }}">{% endblock %}

{% block body %}
    {% include '_admin_nav.html.twig' %}
    <main class="admin-container">
        <div class="admin-heading"><p class="page-eyebrow">J.E ESSENTIALS · STAFF</p><h2>Manage Orders</h2><p>Review customer orders and update their status.</p></div>
        {% for message in app.flashes('success') %}<div class="update-message" role="status">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="update-message error" role="alert">{{ message }}</div>{% endfor %}
        <section class="orders-section">
            <div class="orders-section-header"><h3>Orders</h3><span class="orders-count">{{ orders|length }} {{ orders|length == 1 ? 'order' : 'orders' }}</span></div>
            <form method="get" class="user-filters">
                <label>Search customers <input type="search" name="q" value="{{ filters.q }}" placeholder="Customer name or email"></label>
                <label>Status
                    <select name="status">
                        <option value="">All statuses</option>
                        {% for status in ['pending', 'approved', 'cancelled', 'completed'] %}<option value="{{ status }}" {{ filters.status == status ? 'selected' : '' }}>{{ status|title }}</option>{% endfor %}
                    </select>
                </label>
                <button type="submit" class="edit-btn">Filter Orders</button>
                <a href="{{ path('app_staff_order_index') }}" class="cancel-edit">Clear</a>
            </form>
            {% if orders is empty %}
                <div class="empty-orders"><p>No orders have been placed yet.</p></div>
            {% else %}
                <div class="orders-list">
                    <div class="order-row order-row-header"><span>Order</span><span>Customer</span><span>Total</span><span>Date</span><span>Status</span><span>Action</span></div>
                    {% for order in orders %}
                        <div class="order-row">
                            <div class="order-number">#{{ order.id }}</div>
                            <div><div class="customer-name">{{ order.fullName }}</div><div class="customer-email">{{ order.email }}</div></div>
                            <div class="order-total">₱{{ order.total|number_format(2) }}</div>
                            <div class="order-date">{{ order.createdAt|date('M j, Y') }}</div>
                            <div><span class="status-badge status-{{ order.status|lower|replace({' ': '-'}) }}">{{ order.status|title }}</span></div>
                            <div><a class="view-order-btn" href="{{ path('app_staff_order_show', { id: order.id }) }}">View</a></div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
