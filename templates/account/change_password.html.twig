{% extends 'base.html.twig' %}

{% block title %}Change Password — J.E Essentials{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('shop_css/shop.css') }}"><link rel="stylesheet" href="{{ asset('profile_css/profile.css') }}"><link rel="stylesheet" href="{{ asset('settings_css/settings.css') }}">{% endblock %}

{% block body %}
    {% include '_nav.html.twig' %}
    <main class="settings-page">
        <a href="{{ path('app_account_settings') }}" class="profile-back">&larr; Back to settings</a>
        <section class="settings-header"><p class="profile-eyebrow">MY ACCOUNT</p><h1>Change Password</h1><p>Confirm your current password and choose a new secure password.</p></section>
        <div class="settings-container">
            <section class="settings-card">
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="profile-form-group">{{ form_label(form.currentPassword, 'Current Password') }}{{ form_widget(form.currentPassword) }}{{ form_errors(form.currentPassword) }}</div>
                    <div class="profile-form-group">{{ form_label(form.newPassword, 'New Password') }}{{ form_widget(form.newPassword) }}{{ form_errors(form.newPassword) }}</div>
                    <div class="profile-form-group">{{ form_label(form.confirmPassword, 'Confirm New Password') }}{{ form_widget(form.confirmPassword) }}{{ form_errors(form.confirmPassword) }}</div>
                    <button class="product-submit" type="submit">Update Password</button>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
